{
  "name": "api",
  "version": "26.9",
  "private": true,
  "description": "API Rotaract — CRUD Usuários (MongoDB)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p ../../packages/rotaract-finance/tsconfig.server.json && tsc -p ../../packages/rotaract-settings/tsconfig.server.json && tsc -p ../../packages/rotaract-members/tsconfig.server.json && tsc",
    "start": "node dist/index.js",
    "sync-version": "node scripts/sync-version-from-front.mjs",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@rotaract/finance": "*",
    "@rotaract/members": "*",
    "@rotaract/settings": "*",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "husky": "^9.1.7",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
}